{
  "name": "@kernaio/kernel",
  "version": "0.1.0",
  "description": "Kern module runtime (defineModule, registry, events, call, authz, jobs, settings, storage, http)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/KernAIO/kernel",
    "directory": "packages/kernel"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1115.0",
    "@aws-sdk/s3-request-presigner": "3.1115.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@kernaio/contracts": "^0.1.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/openapi": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "ioredis": "^6.0.0",
    "jose": "^6.0.0",
    "nats": "^2.29.0",
    "pg": "^8.16.0",
    "pg-boss": "^12.0.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
