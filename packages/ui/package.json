{
  "name": "@kernhq/ui",
  "version": "0.10.1",
  "description": "Kern design system — Svelte 5 components, tokens and app-shell layout (Ink/paper)",
  "homepage": "https://kernaio.com",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernAIO/kernel.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "svelte": "./dist/editor/index.js",
      "default": "./dist/editor/index.js"
    },
    "./editor/page-doc": {
      "types": "./dist/editor/page-doc.d.ts",
      "default": "./dist/editor/page-doc.js"
    },
    "./editor/page-schema": {
      "types": "./dist/editor/page-schema.d.ts",
      "default": "./dist/editor/page-schema.js"
    },
    "./package.json": "./package.json",
    "./styles/fonts.css": "./dist/styles/fonts.css",
    "./styles/index.css": "./dist/styles/index.css",
    "./styles/menu.css": "./dist/styles/menu.css",
    "./styles/prose.css": "./dist/styles/prose.css",
    "./styles/theme.css": "./dist/styles/theme.css",
    "./styles/tokens.css": "./dist/styles/tokens.css"
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && publint",
    "dev": "svelte-package -i src/lib -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@tanstack/svelte-query": "^6.1.0",
    "svelte": "^5.46.0"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.6.0",
    "@kernhq/contracts": "^0.7.0",
    "@kernhq/kernel": "^0.7.3",
    "@kernhq/sdk": "^0.1.9",
    "@lucide/svelte": "^1.33.0",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-code-block": "^3.30.5",
    "@tiptap/extension-code-block-lowlight": "^3.30.5",
    "@tiptap/extension-collaboration": "^3.30.5",
    "@tiptap/extension-collaboration-caret": "^3.30.5",
    "@tiptap/extension-details": "^3.30.5",
    "@tiptap/extension-drag-handle": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-list": "^3.30.5",
    "@tiptap/extension-mention": "^3.30.5",
    "@tiptap/extension-node-range": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-table-of-contents": "^3.30.5",
    "@tiptap/extension-unique-id": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "@tiptap/y-tiptap": "^3.0.7",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.0",
    "lowlight": "^3.3.0",
    "tailwind-merge": "^3.6.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@kernhq/tsconfig": "^0.1.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tanstack/svelte-query": "^6.1.0",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.62.1",
    "publint": "^0.3.24",
    "svelte": "^5.56.0",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.0.0"
  }
}
