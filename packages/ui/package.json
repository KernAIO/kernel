{
  "name": "@kernaio/ui",
  "version": "0.1.0",
  "description": "Kern design system \u2014 Svelte 5 components, tokens and app-shell layout (Ink/paper)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernAIO/kernel.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/theme.css": "./dist/styles/theme.css",
    "./styles/fonts.css": "./dist/styles/fonts.css",
    "./styles/index.css": "./dist/styles/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && publint",
    "dev": "svelte-package -i src/lib -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "svelte": "^5.46.0"
  },
  "dependencies": {
    "@kernaio/kernel": "^0.1.0",
    "@lucide/svelte": "^1.33.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.0.0",
    "publint": "^0.3.24",
    "svelte": "^5.56.0",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.0.0"
  }
}
