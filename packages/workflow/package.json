{
  "name": "@kernhq/workflow",
  "version": "0.1.1",
  "description": "Generic workflow / state-machine engine for Kern (statuses, transitions, conditions, validators, post-functions, approvals)",
  "homepage": "https://github.com/KernAIO/kernel/tree/main/packages/workflow#readme",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernAIO/kernel.git",
    "directory": "packages/workflow"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@kernhq/tsconfig": "^0.1.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
