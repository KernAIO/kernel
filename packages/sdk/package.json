{
  "name": "@kernhq/sdk",
  "version": "0.1.2",
  "description": "Typed client SDK for the Kern API and realtime WebSocket",
  "homepage": "https://kernaio.com",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/KernAIO/kernel",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kernhq/contracts": "^0.3.0",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@kernhq/tsconfig": "^0.1.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
