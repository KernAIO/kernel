{
  "name": "@kernalo/testing",
  "version": "0.1.0",
  "description": "Test helpers for Kern services and modules",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/KernALO/kernel",
    "directory": "packages/testing"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kernalo/kernel": "^0.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "pg": "^8.16.0",
    "testcontainers": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
